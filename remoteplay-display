def log(message: str) -> None:
    stamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{stamp}] {message}"
    print(line, file=sys.stderr, flush=True)
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        if LOG_PATH.exists() and LOG_PATH.stat().st_size > LOG_MAX_BYTES:
            LOG_PATH.replace(LOG_PATH.with_suffix(".log.previous"))
        with LOG_PATH.open("a", encoding="utf-8") as handle:
            handle.write(line + "\n")
    except OSError:
        pass


def load_config() -> configparser.SectionProxy:
    parser = configparser.ConfigParser()
    parser["remoteplay"] = dict(DEFAULTS)
    if CONFIG_PATH.exists():
        parser.read(CONFIG_PATH, encoding="utf-8")
    return parser["remoteplay"]


def _csv(cfg, key: str) -> set[str]:
    return {n.strip() for n in str(cfg.get(key, "")).split(",") if n.strip()}


def ignored_outputs(cfg) -> set[str]:
    """Connector names this instance never touches (another instance's dummy, etc.)."""
    return _csv(cfg, "ignore")


STAGED_CACHE = STATE_DIR / "staged-identities.json"


def staged_outputs(cfg) -> set[str]:
    """Connector names switched in their own stage, before and after everything else.

    Meant for sinks behind an MST hub. Disabling or re-enabling the primary output
    while their streams are live forces amdgpu to rebuild the whole chain mid-modeset,
    which KWin does not survive; taking the chain down first and bringing it back last
    keeps each modeset to one link. Names are only used to identify them at switch
    time -- on restore they are matched by EDID, because MST sinks get renumbered.
    """
    return _csv(cfg, "staged")


def resolve_staged(cfg, outputs: dict[str, "Output"]) -> set[str]:
    """Current connector names of the staged outputs.

    Names in the config are a one-time hint: the first time one is seen connected its
    EDID identity is cached, and from then on the match is by identity, so the chain
    being renumbered by the kernel does not silently turn staging off.
    """
    names = staged_outputs(cfg)
    if not names:
        return set()
    try:
        cached = set(json.loads(STAGED_CACHE.read_text(encoding="utf-8")))
    except (OSError, json.JSONDecodeError):
        cached = set()
    learned = {edid_identity(n) for n in names if n in outputs and outputs[n].connected}
    learned.discard(None)
    if learned - cached:
        cached |= learned
        try:
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            STAGED_CACHE.write_text(json.dumps(sorted(cached)), encoding="utf-8")
        except OSError as exc:
            log(f"could not cache staged identities: {exc}")
    resolved = {o.name for o in outputs.values()
                if o.connected and (o.name in names or edid_identity(o.name) in cached)}
    if not resolved:
        log(f"WARNING: 'staged' is set ({', '.join(sorted(names))}) but no connected output "
            f"matches by name or EDID; switching will NOT be staged")
    return resolved


def edid_identity(connector: str) -> str | None:
    """A stable identity for whatever is plugged into a connector, from its EDID.

    Product name + serial descriptors + the numeric serial, so two monitors of the
    same model stay apart even after the kernel renames their connectors.
    """
    for card in sorted(Path("/sys/class/drm").glob(f"card*-{connector}")):
        try:
            data = (card / "edid").read_bytes()
        except OSError:
            continue
        if len(data) < 128:
            continue
        parts = [data[8:16].hex()]
        for offset in range(54, 126, 18):
            block = data[offset:offset + 18]
            if block[0:3] == b"\x00\x00\x00" and block[3] in (0xFC, 0xFF):
                parts.append(block[5:18].split(b"\n")[0].decode("ascii", "replace").strip())
        return "|".join(parts)
    return None


def _connected_identities() -> dict[str, str]:
    """connector name -> EDID identity for every connected connector, straight from sysfs."""
    found: dict[str, str] = {}
    for card in sorted(Path("/sys/class/drm").glob("card*-*")):
        try:
            if (card / "status").read_text().strip() != "connected":
                continue
        except OSError:
            continue
        name = card.name.split("-", 1)[1]
        ident = edid_identity(name)
        if ident:
            found[name] = ident
    return found


def wait_chain_settled(identities: list[str], timeout: float, quiet: float) -> bool:
    """Wait until every wanted EDID identity is connected and the set has stopped changing."""
    deadline = time.monotonic() + timeout
    last, stable_since = None, None
    while True:
        present = _connected_identities()
        have = all(any(v == want for v in present.values()) for want in identities)
        if present != last:
            last, stable_since = present, time.monotonic()
        elif have and time.monotonic() - stable_since >= quiet:
            return True
        if time.monotonic() >= deadline:
            return have
        time.sleep(0.5)


@dataclass(frozen=True)
class Mode:
    id: str
    width: int
    height: int
    refresh: float

    def __str__(self) -> str:
        return f"{self.width}x{self.height}@{self.refresh:.2f}"


@dataclass
class Output:
    name: str
    connected: bool
    enabled: bool
    priority: int
    pos: tuple[int, int]
    scale: float
    rotation: int
    modes: tuple[Mode, ...]
    current_mode_id: str
    hdr_capable: bool = False
    hdr_enabled: bool = False

    @property
    def current_mode(self) -> Mode | None:
        return next((m for m in self.modes if m.id == self.current_mode_id), None)

    def match_mode(self, width: int, height: int, refresh: float) -> Mode | None:
        """Pick the mode with the requested pixel size whose refresh rate is closest."""
        exact = [m for m in self.modes if m.width == width and m.height == height]
        if not exact:
            return None
        return min(exact, key=lambda m: abs(m.refresh - refresh))


@dataclass
class Target:
    name: str
    enabled: bool
    mode_id: str | None = None
    pos: tuple[int, int] | None = None
    scale: float | None = None
    rotation: int | None = None
    priority: int | None = None
    hdr: bool | None = None


class KScreenError(RuntimeError):
    pass


def read_outputs(retries: int = 3) -> dict[str, Output]:
    last_error = ""
    for attempt in range(retries):
        result = subprocess.run(
            ["kscreen-doctor", "--json"], capture_output=True, text=True, timeout=20
        )
        if result.returncode == 0:
            try:
                payload = json.loads(result.stdout)
            except json.JSONDecodeError as exc:
                last_error = f"malformed JSON: {exc}"
            else:
                return {o.name: o for o in (_parse_output(raw) for raw in payload["outputs"])}
        else:
            last_error = (result.stderr or result.stdout).strip()
        if attempt + 1 < retries:
            time.sleep(0.4)
    raise KScreenError(f"kscreen-doctor --json failed: {last_error}")


def _parse_output(raw: dict) -> Output:
    modes = tuple(
        Mode(
            id=str(m["id"]),
            width=int(m["size"]["width"]),
            height=int(m["size"]["height"]),
            refresh=float(m["refreshRate"]),
        )
        for m in raw.get("modes", [])
    )
    pos = raw.get("pos") or {}
    return Output(
        name=raw["name"],
        connected=bool(raw.get("connected")),
        enabled=bool(raw.get("enabled")),
        priority=int(raw.get("priority") or 0),
        pos=(int(pos.get("x", 0)), int(pos.get("y", 0))),
        scale=float(raw.get("scale") or 1.0),
        rotation=int(raw.get("rotation") or 1),
        modes=modes,
        current_mode_id=str(raw.get("currentModeId") or ""),
        hdr_capable="hdr" in raw,
        hdr_enabled=bool(raw.get("hdr")),
    )


def apply_targets(targets: list[Target]) -> None:
    """Push every output change through kscreen-doctor as one atomic transaction."""
    args: list[str] = []
    for target in targets:
        if not target.enabled:
            args.append(f"output.{target.name}.disable")
    for target in targets:
        if not target.enabled:
            continue
        if target.mode_id is not None:
            args.append(f"output.{target.name}.mode.{target.mode_id}")
        if target.pos is not None:
            args.append(f"output.{target.name}.position.{target.pos[0]},{target.pos[1]}")
        if target.scale is not None:
            args.append(f"output.{target.name}.scale.{target.scale:g}")
        if target.rotation in ROTATION_NAMES and target.rotation != 1:
            args.append(f"output.{target.name}.rotation.{ROTATION_NAMES[target.rotation]}")
        if target.priority is not None and target.priority > 0:
            args.append(f"output.{target.name}.priority.{target.priority}")
        args.append(f"output.{target.name}.enable")
        if target.hdr is not None:
            state = "enable" if target.hdr else "disable"
            args.append(f"output.{target.name}.hdr.{state}")
            args.append(f"output.{target.name}.wcg.{state}")
    if not args:
        return
    log(f"kscreen-doctor {' '.join(args)}")
    result = subprocess.run(
        ["kscreen-doctor", *args], capture_output=True, text=True, timeout=30
    )
    if result.returncode != 0:
        raise KScreenError((result.stderr or result.stdout).strip())


def wait_until(predicate, timeout: float) -> dict[str, Output] | None:
    deadline = time.monotonic() + timeout
    while True:
        try:
            snapshot = read_outputs(retries=1)
        except KScreenError:
            snapshot = None
        if snapshot and predicate(snapshot):
            return snapshot
        if time.monotonic() >= deadline:
            return None
        time.sleep(0.25)


def read_state() -> dict:
    try:
        return json.loads(STATE_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}


def write_state(state: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE_PATH.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, indent=2), encoding="utf-8")
    tmp.replace(STATE_PATH)


def clear_state() -> None:
    STATE_PATH.unlink(missing_ok=True)


class StateLock:
    def __enter__(self):
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        self._handle = LOCK_PATH.open("w")
        fcntl.flock(self._handle, fcntl.LOCK_EX)
        return self

    def __exit__(self, *_exc):
        fcntl.flock(self._handle, fcntl.LOCK_UN)
        self._handle.close()
        return False


def sink_present() -> bool:
    try:
        result = subprocess.run(
            ["pactl", "list", "short", "sinks"], capture_output=True, text=True, timeout=10
        )
    except (OSError, subprocess.SubprocessError):
        return False
    return result.returncode == 0 and STREAM_SINK in result.stdout


CAPTURE_RE = re.compile(
    r"^\[(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})\]\[[\d.]+\] "
    r"Maximum capture: (\d+)x(\d+) ([\d.]+) FPS"
)


def latest_capture_hint(cfg) -> tuple[int, int, float] | None:
    """Read the client's advertised capture ceiling from Steam's streaming log."""
    path = Path(os.path.expanduser(cfg["steam_log"]))
    try:
        with path.open("rb") as handle:
            handle.seek(0, os.SEEK_END)
            size = handle.tell()
            handle.seek(max(0, size - 512 * 1024))
            tail = handle.read().decode("utf-8", "replace")
    except OSError:
        return None
    max_age = timedelta(seconds=float(cfg["capture_hint_max_age"]))
    for line in reversed(tail.splitlines()):
        match = CAPTURE_RE.match(line)
        if not match:
            continue
        stamp = datetime.strptime(match.group(1), "%Y-%m-%d %H:%M:%S")
        if datetime.now() - stamp > max_age:
            return None
        return int(match.group(2)), int(match.group(3)), float(match.group(4))
    return None


def parse_mode_spec(spec: str) -> tuple[int, int, float] | None:
    match = re.fullmatch(r"\s*(\d+)x(\d+)(?:@([\d.]+))?\s*", spec)
    if not match:
        return None
    return int(match.group(1)), int(match.group(2)), float(match.group(3) or 60.0)


def sunshine_client_hint() -> tuple[int, int, float] | None:
    """Read the stream geometry Sunshine exports to its prep commands."""
    try:
        width = int(os.environ["SUNSHINE_CLIENT_WIDTH"])
        height = int(os.environ["SUNSHINE_CLIENT_HEIGHT"])
    except (KeyError, ValueError):
        return None
    try:
        fps = float(os.environ.get("SUNSHINE_CLIENT_FPS") or 60.0)
    except ValueError:
        fps = 60.0
    return width, height, fps


def client_hint(cfg, args) -> tuple[int, int, float] | None:
    """Resolve the client's geometry: explicit flag, then Sunshine's env, then Steam's log."""
    spec = getattr(args, "client", None)
    if spec:
        parsed = parse_mode_spec(spec)
        if parsed:
            return parsed
        log(f"ignoring unparseable --client {spec!r}")
    return sunshine_client_hint() or latest_capture_hint(cfg)


def cadence_error(refresh: float, client_fps: float) -> float:
    """How far this refresh rate is from an whole-number multiple of the client's frame rate.

    Capture samples the scanout, so a non-integer ratio delivers frames of uneven age no matter
    how fast either side runs: 119.88 Hz feeding a 90 fps client repeats every fourth frame.
    """
    if client_fps <= 0:
        return 0.0
    ratio = refresh / client_fps
    return abs(ratio - round(ratio))


def choose_dummy_mode(dummy: Output, cfg, hint=None) -> tuple[Mode, str]:
    """Select the dummy mode that best feeds the connected client, refresh rate first."""
    spec = cfg["mode"].strip()
    if spec.lower() != "auto":
        wanted = parse_mode_spec(spec)
        if wanted:
            mode = dummy.match_mode(*wanted)
            if mode:
                return mode, f"configured {spec}"
        log(f"configured mode {spec!r} is not offered by {dummy.name}; falling back")

    if hint:
        cw, ch, cfps = hint
        client_aspect = cw / ch
        floor = parse_mode_spec(cfg["min_mode"])
        min_pixels = floor[0] * floor[1] if floor else 0
        best = max(
            dummy.modes,
            key=lambda m: (
                1 if m.refresh >= cfps - 1.0 else 0,
                -round(abs(m.width / m.height - client_aspect), 2),
                -round(cadence_error(m.refresh, cfps), 2),
                1 if m.width * m.height >= min_pixels else 0,
                1 if (m.width >= cw and m.height >= ch) else 0,
                -abs(m.width * m.height - cw * ch),
                m.refresh,
            ),
        )
        return best, f"client wants {cw}x{ch}@{cfps:g}"

    wanted = parse_mode_spec(cfg["fallback_mode"])
    if wanted:
        mode = dummy.match_mode(*wanted)
        if mode:
            return mode, f"fallback {cfg['fallback_mode']}"
    best = max(dummy.modes, key=lambda m: (m.refresh, m.width * m.height))
    return best, "highest refresh available"


def start_inhibitor(cfg) -> int | None:
    if cfg["inhibit_idle"].strip().lower() not in {"1", "true", "yes", "on"}:
        return None
    try:
        child = subprocess.Popen(
            [os.path.abspath(__file__), "_inhibit"],
            start_new_session=True,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError as exc:
        log(f"could not start idle inhibitor: {exc}")
        return None
    return child.pid


def stop_inhibitor(pid: int | None) -> None:
    if not pid:
        return
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    except OSError as exc:
        log(f"could not stop idle inhibitor {pid}: {exc}")


KWIN_VD = ("org.kde.KWin", "/VirtualDesktopManager", "org.kde.KWin.VirtualDesktopManager")
_UUID = r"[0-9a-fA-F-]{36}"


def _busctl(*args: str) -> str:
    return subprocess.run(["busctl", "--user", *args], check=True, capture_output=True,
                          text=True).stdout.strip()


def _vd_current() -> str:
    out = _busctl("get-property", *KWIN_VD, "current")
    return out.split('"')[1]


def _vd_set_current(desktop_id: str) -> None:
    _busctl("set-property", *KWIN_VD, "current", "s", desktop_id)


def _enabled(cfg, key: str) -> bool:
    return str(cfg.get(key, "false")).strip().lower() in {"1", "true", "yes", "on"}


def enter_scratch_desktop(cfg) -> tuple[str, str] | None:
    """Park the session on a throwaway virtual desktop.

    Disabling every real output makes KWin migrate those outputs' windows onto the
    dummy, so the client opens onto a screen full of the desktop's own windows.
    Virtual-desktop assignment survives that migration, so switching to a fresh empty
    desktop gives the session a clean screen without touching any window.
    """
    if not _enabled(cfg, "scratch_desktop"):
        return None
    name = str(cfg.get("scratch_desktop_name", "Streaming")).strip() or "Streaming"
    try:
        previous = _vd_current()
        count = int(_busctl("get-property", *KWIN_VD, "count").split()[-1])
        _busctl("call", *KWIN_VD, "createDesktop", "us", str(count), name)
        listing = _busctl("get-property", *KWIN_VD, "desktops")
        found = re.findall(rf'"({_UUID})" "{re.escape(name)}"', listing)
        if not found:
            log(f"could not find the {name!r} virtual desktop after creating it")
            return None
        scratch = found[-1]
        _vd_set_current(scratch)
    except (subprocess.CalledProcessError, FileNotFoundError, ValueError, IndexError) as exc:
        log(f"could not create a scratch virtual desktop: {exc}")
        return None
    log(f"streaming on scratch virtual desktop {name!r}")
    return previous, scratch


def leave_scratch_desktop(state: dict) -> None:
    scratch = state.get("scratch_desktop")
    if not scratch:
        return
    previous = state.get("previous_desktop")
    try:
        if previous and _vd_current() == scratch:
            _vd_set_current(previous)
        _busctl("call", *KWIN_VD, "removeDesktop", "s", scratch)
    except (subprocess.CalledProcessError, FileNotFoundError, IndexError) as exc:
        log(f"could not remove the scratch virtual desktop: {exc}")


GAME_PROCESS_RE = re.compile(r"^\[(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})\]\[[\d.]+\] Adding process (\d+) for gameID (\d+)")

KWIN_FOCUS_SCRIPT = """
// pids: oldest process first, newest last (Steam's order). Launchers come first,
// the real game last, so prefer the newest process that has a real window.
const pids = %s;
const target = workspace.currentDesktop;
const byPid = new Map();
for (const w of workspace.windowList()) {
    if (!pids.includes(w.pid)) continue;
    if (!w.normalWindow || w.minimized) continue;
    if (w.width < 320 || w.height < 200) continue;   // splash stubs, tray helpers
    try { w.desktops = [target]; } catch (e) {}
    if (!byPid.has(w.pid)) byPid.set(w.pid, []);
    byPid.get(w.pid).push(w);
}
let picked = null;
for (let i = pids.length - 1; i >= 0 && !picked; i--) {
    const wins = byPid.get(pids[i]);
    if (!wins) continue;
    for (const w of wins) {
        if (!picked || w.width * w.height > picked.width * picked.height) picked = w;
    }
}
if (picked && workspace.activeWindow !== picked) {
    workspace.activeWindow = picked;
}
"""


def streamed_game_pids(cfg, since: datetime) -> list[int]:
    """PIDs Steam has attached to the game it is streaming, from the host log."""
    path = Path(os.path.expanduser(cfg["steam_log"]))
    try:
        with path.open("rb") as handle:
            handle.seek(0, os.SEEK_END)
            handle.seek(max(0, handle.tell() - 256 * 1024))
            tail = handle.read().decode("utf-8", "replace")
    except OSError:
        return []
    pids: list[int] = []
    for line in tail.splitlines():
        match = GAME_PROCESS_RE.match(line)
        if not match:
            continue
        stamp = datetime.strptime(match.group(1), "%Y-%m-%d %H:%M:%S")
        pid = int(match.group(2))
        if stamp >= since - timedelta(seconds=15) and pid not in pids:
            pids.append(pid)          # log order: oldest first, newest last
    return pids


def focus_streamed_game(cfg, since: datetime) -> bool:
    """Bring the streamed game's window onto the current desktop and give it focus.

    A game launched from the client often has its window up before the dummy is
    the only output. Disabling the output it was on leaves it unfocused (and, with
    the scratch desktop, on another desktop), so Steam's capture drops back to the
    desktop, which is black on KDE Wayland. KWin's scripting API can move and
    activate the window by PID; Steam's host log tells us which PIDs are the game.
    """
    if not _enabled(cfg, "focus_game"):
        return False
    pids = streamed_game_pids(cfg, since)
    if not pids:
        return False
    script = KWIN_FOCUS_SCRIPT % json.dumps(pids)
    name = f"{APP}-focus-{os.getpid()}"
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        path = STATE_DIR / f"{name}.js"
        path.write_text(script, encoding="utf-8")
        _busctl("call", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting",
                "unloadScript", "s", name)
        out = _busctl("call", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting",
                      "loadScript", "ss", str(path), name)
        script_id = int(out.split()[-1])
        if script_id < 0:
            log("KWin refused the focus script")
            return False
        _busctl("call", "org.kde.KWin", f"/Scripting/Script{script_id}",
                "org.kde.kwin.Script", "run")
        time.sleep(0.3)
        _busctl("call", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting",
                "unloadScript", "s", name)
    except (subprocess.CalledProcessError, FileNotFoundError, ValueError, OSError) as exc:
        log(f"could not focus the streamed game: {exc}")
        return False
    finally:
        try:
            path.unlink(missing_ok=True)
        except (OSError, NameError):
            pass
    log(f"focused streamed game (pids {pids})")
    return True


def focus_streamed_game_retry(cfg, since: datetime, delays=(0.0, 2.0, 5.0)) -> None:
    """The game's main window may appear a few seconds after launch; try a few times."""
    for i, delay in enumerate(delays):
        if delay:
            time.sleep(delay)
        if focus_streamed_game(cfg, since) and i > 0:
            return


GAME_WINDOW_RE = re.compile(r"^\[(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})\]\[[\d.]+\] Adding window (\d+) \(\d+\) for process (\d+) and gameID")
_focus_tracker: dict = {"size": -1, "sig": None, "pending": []}
FOCUS_FOLLOWUPS = (2.0, 5.0, 10.0)


def _game_signature(cfg, since: datetime) -> tuple:
    """What has changed about the streamed game: its PIDs and the windows Steam saw."""
    pids = streamed_game_pids(cfg, since)
    path = Path(os.path.expanduser(cfg["steam_log"]))
    windows = 0
    try:
        with path.open("rb") as handle:
            handle.seek(0, os.SEEK_END)
            handle.seek(max(0, handle.tell() - 256 * 1024))
            tail = handle.read().decode("utf-8", "replace")
    except OSError:
        return (tuple(pids), 0)
    for line in tail.splitlines():
        match = GAME_WINDOW_RE.match(line)
        if match and int(match.group(3)) in pids:
            if datetime.strptime(match.group(1), "%Y-%m-%d %H:%M:%S") >= since - timedelta(seconds=15):
                windows += 1
    return (tuple(pids), windows)


def maintain_focus(cfg) -> None:
    """Keep the streamed game focused as its processes and windows change mid-session.

    Launchers hand off to the real game seconds or minutes after the stream starts,
    and that window appears unfocused. Cheap to poll: nothing is read unless Steam's
    host log has grown, and the focus script does nothing if the right window is
    already active.
    """
    if not _enabled(cfg, "focus_game"):
        return
    state = read_state()
    if not state.get("active") or state.get("owner") != "auto":
        _focus_tracker["sig"] = None
        _focus_tracker["size"] = -1
        _focus_tracker["pending"] = []
        return
    since = datetime.fromisoformat(state["since"])
    now = time.monotonic()
    # follow-up passes scheduled by an earlier change (a window that went fullscreen
    # a few seconds after it was created leaves no trace in Steam's log)
    due = [t for t in _focus_tracker["pending"] if t <= now]
    if due:
        _focus_tracker["pending"] = [t for t in _focus_tracker["pending"] if t > now]
        focus_streamed_game(cfg, since)
    try:
        size = Path(os.path.expanduser(cfg["steam_log"])).stat().st_size
    except OSError:
        return
    if size == _focus_tracker["size"]:
        return
    _focus_tracker["size"] = size
    sig = _game_signature(cfg, since)
    if sig == _focus_tracker["sig"]:
        return
    first = _focus_tracker["sig"] is None
    _focus_tracker["sig"] = sig
    if not first:
        focus_streamed_game(cfg, since)
        _focus_tracker["pending"] = [now + d for d in FOCUS_FOLLOWUPS]


def activate(cfg, owner: str, hint=None) -> bool:
    with StateLock():
        state = read_state()
        if state.get("active"):
            log(f"already in remote mode (owner={state.get('owner')})")
            return True

        outputs = read_outputs()
        dummy_name = cfg["dummy"].strip()
        skip = ignored_outputs(cfg) | {dummy_name}
        staged = resolve_staged(cfg, outputs) - skip
        dummy = outputs.get(dummy_name)
        if dummy is None or not dummy.connected:
            log(f"dummy output {dummy_name!r} is not connected; refusing to switch")
            return False
        if not dummy.modes:
            log(f"dummy output {dummy_name!r} reports no modes; refusing to switch")
            return False

        mode, reason = choose_dummy_mode(dummy, cfg, hint)
        snapshot = [
            {
                "name": o.name,
                "identity": edid_identity(o.name),
                "staged": o.name in staged,
                "enabled": o.enabled,
                "priority": o.priority,
                "pos": list(o.pos),
                "scale": o.scale,
                "rotation": o.rotation,
                "mode": _mode_record(o),
                "hdr": o.hdr_enabled if o.hdr_capable else None,
            }
            for o in outputs.values()
            if o.connected and o.name not in skip
        ]
        _repair_snapshot(snapshot)

        stage1 = [Target(name=o.name, enabled=False)
                  for o in outputs.values() if o.name in staged and o.enabled]
        targets = [Target(name=dummy_name, enabled=True, mode_id=mode.id, pos=(0, 0),
                          scale=1.0, rotation=1, priority=1,
                          hdr=_wants_hdr(cfg) if dummy.hdr_capable else None)]
        targets += [
            Target(name=o.name, enabled=False)
            for o in outputs.values()
            if o.name not in skip and o.name not in staged and o.enabled
        ]

        log(f"switching to {dummy_name} @ {mode} ({reason}); "
            f"disabling {[t.name for t in stage1] or 'nothing'} first, then "
            f"{[t.name for t in targets if not t.enabled] or 'nothing'}")
        write_state({
            "active": True,
            "owner": owner,
            "dummy": dummy_name,
            "mode": str(mode),
            "since": datetime.now().isoformat(timespec="seconds"),
            "snapshot": snapshot,
            "inhibitor_pid": None,
        })
        settle = float(cfg["settle_timeout"])
        try:
            if stage1:
                apply_targets(stage1)
                gone = {t.name for t in stage1}
                if wait_until(lambda snap: not gone & {o.name for o in snap.values() if o.enabled},
                              settle) is None:
                    log(f"WARNING: {sorted(gone)} still enabled after stage 1; continuing")
                time.sleep(float(cfg["stage_gap"]))
            apply_targets(targets)
        except KScreenError as exc:
            log(f"switch failed: {exc}; restoring")
            clear_state()
            _restore(snapshot, dummy_name, cfg)
            return False

        settled = wait_until(
            lambda snap: _only_enabled(snap, dummy_name, skip)
            and _mode_matches(snap.get(dummy_name), mode),
            settle,
        )
        if settled is None:
            log("WARNING: display state did not settle as expected; retrying once")
            try:
                apply_targets(targets)
            except KScreenError as exc:
                log(f"retry failed: {exc}")
            settled = wait_until(
                lambda snap: _only_enabled(snap, dummy_name, skip),
                settle,
            )
            if settled is None:
                log("ERROR: could not confirm dummy-only layout")

        state = read_state()
        state["inhibitor_pid"] = start_inhibitor(cfg)
        desktops = enter_scratch_desktop(cfg)
        if desktops:
            state["previous_desktop"], state["scratch_desktop"] = desktops
        write_state(state)
        log(f"remote mode active on {dummy_name} @ {mode}")
        if owner == "auto":
            since = datetime.fromisoformat(state["since"])
            focus_streamed_game_retry(cfg, since)
            try:
                _focus_tracker["size"] = Path(os.path.expanduser(cfg["steam_log"])).stat().st_size
                _focus_tracker["sig"] = _game_signature(cfg, since)
            except OSError:
                pass
        return True


def _wants_hdr(cfg) -> bool:
    """Whether the dummy should be driven in HDR.

    Both ends have to agree: capturing an HDR output while the client asks for SDR
    forces a tone-map that looks worse than either mode on its own.
    """
    return str(cfg.get("hdr", "false")).strip().lower() in {"1", "true", "yes", "on"}


def _repair_snapshot(snapshot: list[dict]) -> None:
    """Never record a desktop layout in which every real monitor is already dark.

    KWin replays a saved output setup whenever the dummy is hot-plugged, and one of
    those setups can legitimately have the real monitors disabled. Snapshotting that
    state would make the post-session restore faithfully turn the desktop off.
    """
    if not snapshot or any(e["enabled"] for e in snapshot):
        return
    for entry in snapshot:
        entry["enabled"] = True
    log(f"snapshot had every non-dummy output disabled; recording "
        f"{[e['name'] for e in snapshot]} as enabled so the restore brings them back")


def _mode_record(output: Output) -> dict | None:
    mode = output.current_mode
    if mode is None:
        return None
    return {"width": mode.width, "height": mode.height, "refresh": mode.refresh}


def _only_enabled(snapshot: dict[str, Output], name: str, skip: set[str] = frozenset()) -> bool:
    """True when `name` is the only enabled output, ignoring outputs in `skip`.

    `skip` may contain `name` itself (callers pass ignore | {dummy}); it must never be
    filtered out here, or the check can never pass.
    """
    enabled = {o.name for o in snapshot.values()
               if o.enabled and (o.name == name or o.name not in skip)}
    return enabled == {name}


def _mode_matches(output: Output | None, mode: Mode) -> bool:
    if output is None:
        return False
    current = output.current_mode
    return bool(current and current.width == mode.width and current.height == mode.height)


def deactivate(cfg, force: bool = False, owner: str | None = None) -> bool:
    with StateLock():
        state = read_state()
        if not state.get("active"):
            if force:
                log("no saved remote-mode state; nothing to restore")
            return True
        if owner is not None and state.get("owner") != owner:
            log(f"layout is owned by {state.get('owner')!r}, not {owner!r}; leaving it alone")
            return True
        stop_inhibitor(state.get("inhibitor_pid"))
        leave_scratch_desktop(state)
        ok = _restore(state.get("snapshot") or [], state.get("dummy", ""), cfg)
        clear_state()
        log("desktop layout restored" if ok else "desktop layout restore incomplete")
        return ok


def _resolve(entry: dict, outputs: dict[str, Output], claimed: set[str]) -> Output | None:
    """Find the connected output a snapshot entry refers to: by EDID identity, then name."""
    ident = entry.get("identity")
    if ident:
        for o in outputs.values():
            if o.connected and o.name not in claimed and edid_identity(o.name) == ident:
                return o
    o = outputs.get(entry["name"])
    if o is not None and o.connected and o.name not in claimed:
        return o
    return None


def _restore_targets(entries: list[dict], outputs: dict[str, Output],
                     claimed: set[str]) -> list[Target]:
    targets: list[Target] = []
    for entry in entries:
        output = _resolve(entry, outputs, claimed)
        if output is None:
            log(f"skipping {entry['name']}: no longer connected")
            continue
        claimed.add(output.name)
        if output.name != entry["name"]:
            log(f"{entry['name']} is now {output.name} (matched by EDID)")
        if not entry["enabled"]:
            targets.append(Target(name=output.name, enabled=False))
            continue
        mode_id = None
        record = entry.get("mode")
        if record:
            mode = output.match_mode(record["width"], record["height"], record["refresh"])
            mode_id = mode.id if mode else None
            if mode_id is None:
                log(f"{output.name}: saved mode {record['width']}x{record['height']} "
                    f"unavailable, leaving current mode")
        targets.append(Target(
            name=output.name,
            enabled=True,
            mode_id=mode_id,
            pos=tuple(entry["pos"]),
            scale=entry.get("scale"),
            rotation=entry.get("rotation"),
            priority=entry.get("priority"),
            hdr=entry.get("hdr") if output.hdr_capable else None,
        ))
    return targets


def _apply_and_wait(targets: list[Target], dummy_name: str, settle_timeout: float,
                    label: str) -> bool:
    try:
        apply_targets(targets)
    except KScreenError as exc:
        log(f"restore ({label}) failed: {exc}")
        return False
    expected = {t.name for t in targets if t.enabled}
    settled = wait_until(
        lambda snap: expected <= {o.name for o in snap.values() if o.enabled}
        and dummy_name not in {o.name for o in snap.values() if o.enabled} - expected,
        settle_timeout,
    )
    if settled is None:
        log(f"WARNING: {label} did not settle as expected after restore")
    return settled is not None


def _restore(snapshot: list[dict], dummy_name: str, cfg) -> bool:
    """Bring the saved layout back, chain-staged outputs last.

    Stage 1 disables the dummy and re-enables every unstaged output (the primary
    among them). Stage 2 waits for the MST chain to finish re-enumerating behind
    that, then re-enables the staged outputs, matched by EDID since their names
    may have changed.
    """
    settle_timeout = float(cfg["settle_timeout"])
    try:
        outputs = read_outputs()
    except KScreenError as exc:
        log(f"cannot read outputs while restoring: {exc}")
        return False

    skip = ignored_outputs(cfg) | {dummy_name}
    entries = [e for e in snapshot if e["name"] not in skip]
    first = [e for e in entries if not e.get("staged")]
    later = [e for e in entries if e.get("staged")]

    claimed: set[str] = set()
    targets = _restore_targets(first, outputs, claimed)

    if not any(t.enabled for t in targets) and not later:
        log("WARNING: no saved output is connected; keeping the dummy enabled")
        if dummy_name in outputs:
            targets.append(Target(name=dummy_name, enabled=True))
    elif dummy_name in outputs:
        targets.insert(0, Target(name=dummy_name, enabled=False))

    ok = True
    if targets:
        ok = _apply_and_wait(targets, dummy_name, settle_timeout, "stage 1")

    if later:
        wanted = [e["identity"] for e in later if e.get("identity")]
        if not wait_chain_settled(wanted, settle_timeout * 2, float(cfg["chain_settle"])):
            log("WARNING: chain outputs did not all reappear; restoring what is there")
        try:
            outputs = read_outputs()
        except KScreenError as exc:
            log(f"cannot read outputs for stage 2: {exc}")
            return False
        targets = _restore_targets(later, outputs, claimed)
        if targets:
            ok = _apply_and_wait(targets, dummy_name, settle_timeout, "stage 2") and ok
        elif not any(o.enabled for o in outputs.values() if o.name not in skip):
            log("WARNING: nothing came back; re-enabling the dummy so the desktop is not dark")
            if dummy_name in outputs:
                _apply_and_wait([Target(name=dummy_name, enabled=True)], "", settle_timeout, "fallback")
            ok = False
    return ok


def cmd_on(cfg, args) -> int:
    owner = (getattr(args, "owner", None) or "manual").strip()
    return 0 if activate(cfg, owner=owner, hint=client_hint(cfg, args)) else 1


def cmd_off(cfg, args) -> int:
    owner = (getattr(args, "owner", None) or "").strip() or None
    return 0 if deactivate(cfg, force=True, owner=owner) else 1


def cmd_toggle(cfg, args) -> int:
    return cmd_off(cfg, args) if read_state().get("active") else cmd_on(cfg, args)


def primary_output(outputs: dict[str, Output]) -> Output | None:
    """The output a fullscreen game will land on: lowest priority among the enabled ones.

    Priority survives on a disabled output, so the dummy still reports priority 1 while
    it is dark; filtering to enabled outputs first is what makes this correct in both
    the streaming and the desktop layout.
    """
    live = [o for o in outputs.values() if o.enabled]
    if not live:
        return None
    return min(live, key=lambda o: (o.priority if o.priority > 0 else 1 << 30, o.name))


def cmd_gamescope_args(cfg, args) -> int:
    """Print the gamescope flags that make a game fill whatever display is live now.

    A launch option is baked in when the game starts, but the target display is not:
    the same title runs on the desktop monitor locally and on the dummy while
    streaming, at different sizes, rates and HDR states. Resolving the flags at launch
    time from the live layout lets one launch option serve both.
    """
    try:
        outputs = read_outputs()
    except KScreenError as exc:
        log(f"gamescope-args: {exc}; falling back to {cfg['fallback_mode']}")
        outputs = {}

    output = primary_output(outputs)
    mode = output.current_mode if output else None
    if mode is None:
        wanted = parse_mode_spec(cfg["fallback_mode"])
        if not wanted:
            return 1
        width, height, refresh = wanted
        hdr = False
    else:
        width, height, refresh = mode.width, mode.height, mode.refresh
        hdr = output.hdr_enabled

    flags = ["-W", str(width), "-H", str(height), "-r", str(round(refresh))]
    if hdr and not getattr(args, "no_hdr", False):
        flags.append("--hdr-enabled")
    if getattr(args, "fullscreen", False):
        flags.append("-f")
    print(" ".join(flags))
    return 0


def cmd_rescue(cfg, _args) -> int:
    """Light up every real monitor at its preferred mode, ignoring any saved state.

    The escape hatch for a dark desktop: mode ids are renumbered whenever the set of
    connected outputs changes, so a hand-written kscreen-doctor call with stale ids
    silently fails. This resolves them fresh.
    """
    dummy_name = cfg["dummy"].strip()
    skip = ignored_outputs(cfg) | {dummy_name}
    cap = float(cfg.get("rescue_max_refresh", "0") or 0)
    try:
        outputs = read_outputs()
    except KScreenError as exc:
        log(f"rescue failed: {exc}")
        return 1

    targets, x = [], 0
    for output in outputs.values():
        if not output.connected or output.name in skip:
            continue
        candidates = [m for m in output.modes if cap <= 0 or m.refresh <= cap + 0.5]
        mode = max(candidates or output.modes,
                   key=lambda m: (m.width * m.height, m.refresh), default=None)
        targets.append(Target(
            name=output.name, enabled=True, mode_id=mode.id if mode else None,
            pos=(x, 0), scale=1.0, rotation=0, priority=len(targets) + 1,
        ))
        if mode:
            x += mode.width

    if not targets:
        log("rescue: no non-dummy output is connected")
        return 1

    log(f"rescue: enabling {[t.name for t in targets]}")
    try:
        apply_targets(targets)
    except KScreenError as exc:
        log(f"rescue failed: {exc}")
        return 1
    clear_state()
    log("rescue: desktop restored")
    return 0


def cmd_status(cfg, _args) -> int:
    state = read_state()
    session = sink_present()
    print(f"mode:      {'REMOTE' if state.get('active') else 'desktop'}")
    if state.get("active"):
        print(f"owner:     {state.get('owner')}")
        print(f"dummy:     {state.get('dummy')} @ {state.get('mode')}")
        print(f"since:     {state.get('since')}")
    print(f"session:   {'streaming' if session else 'idle'} ({STREAM_SINK})")
    try:
        outputs = read_outputs()
    except KScreenError as exc:
        print(f"outputs:   unavailable ({exc})")
        return 1
    print("outputs:")
    for output in sorted(outputs.values(), key=lambda o: (not o.enabled, o.priority, o.name)):
        flag = "on " if output.enabled else "off"
        current = output.current_mode
        detail = f"{current}" if current else "-"
        tag = "  <- dummy" if output.name == cfg["dummy"].strip() else ""
        print(f"  {flag} {output.name:<10} {detail:<18} pos={output.pos[0]},{output.pos[1]} "
              f"prio={output.priority}{tag}")
    return 0


def cmd_doctor(cfg, args) -> int:
    problems = 0
    print(f"config:    {CONFIG_PATH} ({'present' if CONFIG_PATH.exists() else 'defaults'})")
    print(f"state:     {STATE_PATH}")
    print(f"log:       {LOG_PATH}")

    for tool in ("kscreen-doctor", "pactl"):
        found = subprocess.run(["which", tool], capture_output=True, text=True).returncode == 0
        print(f"tool:      {tool} {'ok' if found else 'MISSING'}")
        problems += 0 if found else 1

    dummy_name = cfg["dummy"].strip()
    try:
        outputs = read_outputs()
    except KScreenError as exc:
        print(f"outputs:   FAILED ({exc})")
        return 1

    print("connectors:")
    for output in outputs.values():
        name = edid_product_name(output.name) or "-"
        mark = "  <- configured dummy" if output.name == dummy_name else ""
        state = "connected" if output.connected else "disconnected"
        print(f"  {output.name:<10} {state:<13} edid={name!r}{mark}")

    if staged_outputs(cfg):
        print(f"staged:    {sorted(resolve_staged(cfg, outputs)) or 'NONE MATCHED'} "
              f"(config: {', '.join(sorted(staged_outputs(cfg)))})")
    if ignored_outputs(cfg):
        print(f"ignore:    {', '.join(sorted(ignored_outputs(cfg)))}")
    dummy = outputs.get(dummy_name)
    if dummy is None or not dummy.connected:
        print(f"dummy:     NOT CONNECTED ({dummy_name}) - fix 'dummy' in {CONFIG_PATH}")
        problems += 1
    else:
        hint = client_hint(cfg, args)
        mode, reason = choose_dummy_mode(dummy, cfg, hint)
        print(f"dummy:     {dummy_name} ok, {len(dummy.modes)} modes")
        print(f"selection: {mode} ({reason})")

    steam_log = Path(os.path.expanduser(cfg["steam_log"]))
    print(f"steam log: {steam_log} {'ok' if steam_log.exists() else 'MISSING'}")
    print(f"hint:      {latest_capture_hint(cfg) or 'none recent'}")
    print(f"sunshine:  {sunshine_integration_status()}")

    unit = subprocess.run(
        ["systemctl", "--user", "is-active", f"{APP}.service"],
        capture_output=True, text=True,
    ).stdout.strip()
    print(f"service:   {APP}.service is {unit or 'unknown'}")
    problems += 0 if unit == "active" else 1

    print(f"result:    {'all good' if problems == 0 else f'{problems} problem(s)'}")
    return 0 if problems == 0 else 1


def sunshine_integration_status() -> str:
    """Report whether Sunshine's prep commands hand sessions to this tool."""
    conf = CONFIG_HOME / "sunshine" / "sunshine.conf"
    if not conf.exists():
        return "not installed"
    try:
        text = conf.read_text(encoding="utf-8")
    except OSError as exc:
        return f"unreadable ({exc})"
    prep = next(
        (line for line in text.splitlines() if line.strip().startswith("global_prep_cmd")), ""
    )
    if APP not in prep:
        return f"installed, global_prep_cmd NOT wired - see {conf}"
    output = next(
        (line for line in text.splitlines() if line.strip().startswith("output_name")), ""
    )
    index = output.split("=", 1)[1].strip() if "=" in output else "unset"
    warn = "" if index == "0" else f"; WARNING output_name={index}, expected 0"
    return f"wired via global_prep_cmd{warn}"


def edid_product_name(connector: str) -> str | None:
    """Pull the display product name descriptor out of the connector's raw EDID."""
    for card in sorted(Path("/sys/class/drm").glob(f"card*-{connector}")):
        try:
            data = (card / "edid").read_bytes()
        except OSError:
            continue
        if len(data) < 128:
            continue
        for offset in range(54, 126, 18):
            block = data[offset:offset + 18]
            if block[0:3] == b"\x00\x00\x00" and block[3] == 0xFC:
                text = block[5:18].split(b"\n")[0]
                return text.decode("ascii", "replace").strip()
    return None


def cmd_inhibit(_cfg, _args) -> int:
    holds = []
    try:
        import dbus

        session = dbus.SessionBus()
        for path in ("/org/freedesktop/ScreenSaver", "/ScreenSaver"):
            try:
                obj = session.get_object("org.freedesktop.ScreenSaver", path)
                holds.append(obj.Inhibit(
                    APP, "Steam Remote Play session",
                    dbus_interface="org.freedesktop.ScreenSaver",
                ))
                break
            except dbus.DBusException:
                continue
        system = dbus.SystemBus()
        login1 = system.get_object("org.freedesktop.login1", "/org/freedesktop/login1")
        holds.append(login1.Inhibit(
            "idle:sleep", APP, "Steam Remote Play session", "block",
            dbus_interface="org.freedesktop.login1.Manager",
        ))
    except Exception as exc:
        log(f"dbus inhibit unavailable ({exc}); falling back to systemd-inhibit")
        os.execvp("systemd-inhibit", [
            "systemd-inhibit", "--what=idle:sleep", f"--who={APP}",
            "--why=Steam Remote Play session", "--mode=block", "sleep", "infinity",
        ])

    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    signal.signal(signal.SIGINT, lambda *_: sys.exit(0))
    while True:
        signal.pause()


class _Stopped(Exception):
    pass


def cmd_watch(cfg, _args) -> int:
    auto = cfg["auto"].strip().lower() in {"1", "true", "yes", "on"}
    log(f"watching for {STREAM_SINK} (auto={'on' if auto else 'off'}, dummy={cfg['dummy']})")

    def _stop(*_signal):
        raise _Stopped()

    signal.signal(signal.SIGTERM, _stop)
    signal.signal(signal.SIGINT, _stop)

    try:
        return _watch_loop(cfg, auto)
    except _Stopped:
        log("stopping; releasing any layout this daemon applied")
        state = read_state()
        if state.get("active") and state.get("owner") == "auto":
            deactivate(cfg)
        return 0


def _watch_loop(cfg, auto: bool) -> int:
    _recover_stale_state(cfg)
    known = sink_present()
    log(f"initial session state: {'streaming' if known else 'idle'}")

    while True:
        proc = subprocess.Popen(
            ["pactl", "subscribe"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, bufsize=1,
        )
        try:
            known = _consume_events(cfg, proc, auto, known)
        finally:
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
        log("pactl subscribe ended; reconnecting in 3s")
        time.sleep(3)


def _consume_events(cfg, proc, auto: bool, known: bool) -> bool:
    """Sleep until a debounced sink event or the safety tick, so idle costs no subprocesses."""
    selector = selectors.DefaultSelector()
    selector.register(proc.stdout, selectors.EVENT_READ)
    pending_until = None
    last_reconcile = time.monotonic()
    while proc.poll() is None:
        if auto:
            maintain_focus(cfg)
        deadline = pending_until if pending_until else last_reconcile + RECONCILE_INTERVAL
        wait = max(0.05, min(MAX_SELECT_WAIT, deadline - time.monotonic()))
        if selector.select(timeout=wait):
            while True:
                line = proc.stdout.readline()
                if not line:
                    return known
                if "sink" in line or "server" in line:
                    pending_until = time.monotonic() + EVENT_DEBOUNCE
                if not selector.select(timeout=0):
                    break
            continue
        if pending_until and time.monotonic() < pending_until:
            continue
        pending_until = None
        last_reconcile = time.monotonic()
        known = _reconcile(cfg, auto, known)
    return known


def _reconcile(cfg, auto: bool, known: bool) -> bool:
    present = sink_present()
    if present == known:
        return known
    log(f"session {'started' if present else 'ended'}")
    if not auto:
        return present
    state = read_state()
    if present and not state.get("active"):
        activate(cfg, owner="auto")
    elif not present and state.get("active") and state.get("owner") == "auto":
        deactivate(cfg)
    return present


def _recover_stale_state(cfg) -> None:
    state = read_state()
    if state.get("active") and state.get("owner") == "auto" and not sink_present():
        log("found stale remote-mode state from a previous run; restoring desktop")
        deactivate(cfg)


COMMANDS = {
    "status": cmd_status,
    "on": cmd_on,
    "off": cmd_off,
    "toggle": cmd_toggle,
    "rescue": cmd_rescue,
    "gamescope-args": cmd_gamescope_args,
    "watch": cmd_watch,
    "doctor": cmd_doctor,
    "_inhibit": cmd_inhibit,
}


def main() -> int:
    parser = argparse.ArgumentParser(
        prog=APP,
        description="Route remote play sessions to a dummy HDMI output.",
    )
    parser.add_argument(
        "command",
        nargs="?",
        default="status",
        choices=[c for c in COMMANDS if not c.startswith("_")] + ["_inhibit"],
        help="status (default), on, off, toggle, rescue, gamescope-args, watch, doctor",
    )
    parser.add_argument(
        "--fullscreen",
        action="store_true",
        help="gamescope-args: also emit -f",
    )
    parser.add_argument(
        "--no-hdr",
        action="store_true",
        help="gamescope-args: never emit --hdr-enabled",
    )
    parser.add_argument(
        "--client",
        metavar="WxH[@FPS]",
        help="client geometry to pick the dummy mode for; overrides autodetection",
    )
    parser.add_argument(
        "--owner",
        metavar="NAME",
        help="tag the layout (on) or only restore a layout with this tag (off)",
    )
    args = parser.parse_args()
    cfg = load_config()
    try:
        return COMMANDS[args.command](cfg, args)
    except KScreenError as exc:
        log(f"ERROR: {exc}")
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
